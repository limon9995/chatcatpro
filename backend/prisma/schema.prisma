generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  username  String   @unique
  name      String   @default("")
  role      String   @default("client")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // V12: Auth fields moved from JSON file to DB
  passwordHash        String  @default("")
  salt                String  @default("")
  forcePasswordChange Boolean @default(false)
  pageIds             String  @default("[]") // JSON array of page DB ids

  // Google OAuth login — nullable, existing username/password users unaffected
  googleId String? @unique

  pages         Page[]
  sessions      Session[]
  subscriptions Subscription[]
  pageRequests  PageRequest[]
  agentRequests AgentRequest[]

  @@index([username])
  @@index([email])
}

// OTP tokens for email verification and password reset
model OtpToken {
  id        String   @id @default(uuid())
  email     String
  code      String
  purpose   String // 'signup' | 'reset'
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// V12: Session moved from sessions.json to DB
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("client")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Page {
  id          Int    @id @default(autoincrement())
  pageId      String @unique
  pageName    String @default("")
  pageToken   String @default("")
  verifyToken String @default("")
  fbAppId     String? // User's own FB Developer App ID (plaintext)
  fbAppSecret String? // User's own FB App Secret — AES-256 encrypted

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Linked pages: if masterPageId is set, this page shares settings/products/bot-knowledge from master
  masterPageId Int?
  masterPage   Page?  @relation("LinkedPages", fields: [masterPageId], references: [id], onDelete: SetNull)
  linkedPages  Page[] @relation("LinkedPages")

  isActive                  Boolean @default(true)
  automationOn              Boolean @default(false)
  automationAllowed         Boolean @default(true)
  ocrOn                     Boolean @default(false)
  ocrAllowed                Boolean @default(true)
  infoModeOn                Boolean @default(true)
  infoModeAllowed           Boolean @default(true)
  orderModeOn               Boolean @default(true)
  orderModeAllowed          Boolean @default(true)
  printModeOn               Boolean @default(false)
  printModeAllowed          Boolean @default(true)
  memoSaveModeOn            Boolean @default(false)
  memoSaveModeAllowed       Boolean @default(true)
  memoTemplateModeOn        Boolean @default(false)
  memoTemplateModeAllowed   Boolean @default(true)
  autoMemoDesignModeOn      Boolean @default(false)
  autoMemoDesignModeAllowed Boolean @default(true)
  memoTheme                 String  @default("classic")
  memoLayout                String  @default("memo")
  memosPerPage              Int     @default(3)

  businessName            String?
  businessPhone           String?
  businessAddress         String?
  phone                   String?
  address                 String?
  logoUrl                 String?
  memoFooterText          String?
  codLabel                String  @default("COD")
  currencySymbol          String  @default("৳")
  primaryColor            String?
  catalogMessengerUrl     String? // Custom link for catalog "Order on Messenger" button
  catalogSlug             String? @unique // e.g. "limon-tech-diary" → /catalog/limon-tech-diary
  customDomain            String? @unique // e.g. "shop.mybrand.com" — customer's personal domain
  // V21: Catalog analytics
  catalogViews            Int     @default(0)
  websiteUrl              String? // Optional external store/website URL; bot can send this instead of hosted catalog
  // V8: Custom product code prefix (e.g. "SK", "FZ", "BD"). Default "DF"
  productCodePrefix       String  @default("DF")
  deliveryFeeInsideDhaka    Float   @default(80)
  deliveryFeeOutsideDhaka   Float   @default(120)
  deliveryTimeText          String?
  deliveryTimeInsideDhaka   String?
  deliveryTimeOutsideDhaka  String?

  // V17: Payment mode — controls how bot collects payment before confirming order
  // 'cod' = full cash on delivery (default)
  // 'advance_outside' = advance required for outside-Dhaka orders, COD inside
  // 'full_advance' = full advance required for every order
  paymentMode           String  @default("cod")
  advanceAmount         Float   @default(0) // 0 = delivery fee only, >0 = custom fixed amount
  advanceBkash          String? // Bkash number shown to customer
  advanceNagad          String? // Nagad number shown to customer
  advanceRocket         String? // Rocket number shown to customer
  advancePaymentMessage String? // Custom advance payment message template (supports {{amount}}, {{bkash}}, {{nagad}}, {{currency}})
  codEnabled             Boolean @default(true) // false = COD not accepted at all; advance always required
  advanceThresholdAmount Float   @default(0) // >0 = only require advance when order subtotal exceeds this amount; 0 = always apply paymentMode's rule

  // V23: Web ordering
  webOrderEnabled Boolean @default(false) // merchant can enable direct web checkout from catalog
  websiteEnabled  Boolean @default(true)  // admin can disable the public catalog website (bot still works)

  // V24: Restaurant mode — self-delivery within a short radius, map-pin checkout,
  // distance-slab delivery fees. When ready (flag + pin + slabs), inside/outside
  // Dhaka fees stop applying to this page everywhere (catalog, bot, quick replies).
  restaurantModeEnabled Boolean @default(false)
  restaurantLat         Float? // restaurant location pin
  restaurantLng         Float?
  deliverySlabsJson     String? // JSON [{maxKm, fee}] sorted ascending; beyond last slab = no delivery
  // V25: per-ORDER packaging consumed once per order regardless of items,
  // e.g. 1 carry bag: [{ingredientId, qty}]
  orderPackagingJson    String?
  // V25: physical menu photos (/storage/ URLs) — auto-saved on menu scan;
  // sent to customers in Messenger when they ask what's available
  menuImagesJson        String?

  callConfirmModeOn       Boolean @default(false)
  callConfirmModeAllowed  Boolean @default(true)
  callMode                String  @default("MANUAL")
  callConfirmationScope   String  @default("ALL")
  initialCallDelayMinutes Int     @default(30)
  retryIntervalMinutes    Int     @default(30)
  maxCallRetries          Int     @default(3)

  // V18: Image recognition feature settings
  imageRecognitionOn    Boolean @default(false) // master toggle for vision-based product search
  imageHighConfidence   Float   @default(0.75) // >= this: auto-proceed with top match
  imageMediumConfidence Float   @default(0.45) // >= this: show options, ask customer
  imageFallbackAiOn     Boolean @default(false) // use AI fallback when low confidence
  textFallbackAiOn      Boolean @default(false) // use AI fallback for unmatched text messages
  smartBotOn            Boolean @default(true)   // V20: SmartBot — single AI call is the bot brain (keyword pipeline retired); default ON for all pages
  businessBotOn         Boolean @default(false)  // Business Info Bot — replies to all messages using businessInfo
  businessInfo          String? // Full business description; used as AI knowledge base for businessBotOn mode
  commentReplyOn        Boolean @default(false)
  commentReplyAllowed   Boolean @default(true)
  costPerCommentReplyBdt Float  @default(0.05)

  callLanguage        String    @default("BN")
  voiceType           String    @default("FEMALE")
  voiceStyle          String    @default("NATURAL")
  callProvider        String?
  ttsProvider         String?
  banglaVoiceId       String?
  englishVoiceId      String?
  banglaCallScript    String?
  englishCallScript   String?
  banglaVoiceFileUrl  String?
  englishVoiceFileUrl String?
  voiceGeneratedAt    DateTime?

  // -- WALLET SYSTEM --
  walletBalanceBdt Float @default(0.0) // Core currency balance for usage

  // -- TELEGRAM MERCHANT NOTIFICATIONS --
  telegramBotToken     String? // encrypted (AES-256-GCM via EncryptionService)
  telegramChatId       String? // plaintext, not sensitive
  telegramNotifEnabled Boolean @default(false)
  lowBalanceNotifiedAt DateTime? // debounce: last low-balance alert sent
  subExpiryNotifiedAt  DateTime? // debounce: last subscription-expiry alert sent

  // V24: owner opt-out for the new "new order" email alert (Telegram alert unaffected).
  orderEmailNotifEnabled Boolean @default(true)

  // -- PRICING CONFIG --
  costPerTextMsgBdt       Float @default(0.05)
  costPerVoiceMsgBdt      Float @default(1.00)  // For processing audio voice notes
  costPerImageBdt         Float @default(0.20)  // Customer image — Gemini Vision API path
  costPerImageLocalBdt    Float @default(0.10)  // Customer image — local Ollama path (no API)
  costPerAnalyzeBdt       Float @default(0.20)  // Admin uploading product
  costPerAiGenerateBdt    Float @default(0.10)  // AI text generation (description/broadcast draft)
  costPerKeywordReplyBdt       Float @default(0.02)   // Pure keyword/template bot reply (no AI call)
  costPerBroadcastMsgBdt       Float @default(0.05)   // Per broadcast message sent
  costPerOcrLocalBdt           Float @default(0.02)   // OCR via local Tesseract
  costPerOcrAiBdt              Float @default(0.05)   // OCR via Gemini fallback
  costPerRecurringNotifBdt     Float @default(0.10)   // Recurring notification broadcast per message
  recurringNotifMode           Boolean @default(false) // When ON: ask subscribe permission after order complete/cancel

  // -- DUAL PHOTO MODE (legacy single-pair, kept for backward compat) --
  dualPhotoMode        Boolean  @default(false)
  dualWearingProductId Int?
  dualHoldingProductId Int?
  dualWearingProduct   Product? @relation("DualWearing", fields: [dualWearingProductId], references: [id])
  dualHoldingProduct   Product? @relation("DualHolding", fields: [dualHoldingProductId], references: [id])

  // -- UNIVERSITY MODE --
  universityModeOn      Boolean @default(false) // When ON: routes all Messenger messages to university bot, bypasses commerce pipeline
  universityModeAllowed Boolean @default(true)
  universityConfig      UniversityConfig?

  // -- BOT AGENT SELECTION --
  // Matches a registered BotAgent key ("commerce", "university", ...) or a
  // BotAgentDefinition.agentKey with no dedicated class yet (falls back to "commerce").
  agentType String @default("commerce")

  // Per-page override of the shared BotAgentDefinition.behaviorConfig.personaPrompt —
  // lets an individual business set its own bot tone/personality. Takes priority
  // over the agentType-level persona when set; falls back to it when empty.
  customPersonaPrompt String?

  // -- BUSINESS KNOWLEDGE --
  knowledgeText String @default("") // Client FAQ, policies, product info — fed to AI system prompt

  // -- BASE SUBSCRIPTION --
  subscriptionStatus String    @default("ACTIVE") // ACTIVE, SUSPENDED
  nextBillingDate    DateTime?

  // Page reconnect audit
  lastReconnectedAt DateTime? // when FB page was last changed via reconnect
  previousPageId    String? // old FB page ID before the last reconnect

  // ── WhatsApp Business API ──────────────────────────────────────────────────
  waEnabled               Boolean @default(false) // master toggle for WA automation
  waPhoneNumberId         String? // Meta phone number ID (e.g. "123456789012345")
  waToken                 String? // encrypted WA Cloud API access token
  waVerifyToken           String? // webhook verify token for WA
  waFallbackTemplateName  String? // approved template name for 24h window fallback

  // ── Instagram Business API ────────────────────────────────────────────────
  igEnabled           Boolean @default(false) // master toggle for IG automation
  igBusinessAccountId String? // Instagram Business Account ID
  igToken             String? // encrypted IG access token
  igVerifyToken       String? // webhook verify token for IG
  igCommentToDmEnabled Boolean @default(true) // auto-DM commenters after product/order detected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders               Order[]
  products             Product[]
  ingredients          Ingredient[]
  conversationSessions ConversationSession[]
  callAttempts         CallAttempt[]
  memoTemplate         MemoTemplate?
  pageRequests         PageRequest[]

  // V5 Accounting
  collections     Collection[]
  expenses        Expense[]
  returnEntries   ReturnEntry[]
  exchangeEntries ExchangeEntry[]

  // V9
  customers        Customer[]
  followUps        FollowUp[]
  broadcasts       Broadcast[]
  courierShipments CourierShipment[]

  // Wallet
  walletTransactions      WalletTransaction[]
  walletRechargeRequests  WalletRechargeRequest[]
  recurringSubscribers    RecurringSubscriber[]

  // Spam checker
  spamCheckLogs SpamCheckLog[]

  // Live sessions (new dual photo system)
  liveSessions LiveSession[]
  autoPosts    AutoPost[]

  // Payment credentials for auto-verification
  paymentCredentials PaymentCredential[]

  // SMS Gateway for payment verification
  smsGatewayToken    String?  // unique secret token for Android SMS forwarder webhook
  smsGatewayEnabled  Boolean  @default(false)
  receivedSms        ReceivedSms[]

  costPerMemoPrintBdt  Float @default(0.10)

  @@index([masterPageId])
}

model Product {
  id     Int  @id @default(autoincrement())
  pageId Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  code        String
  name        String?
  price       Float   @default(0)
  costPrice   Float   @default(0) // V5: for profit estimation
  stockQty    Int     @default(0)
  imageUrl    String?
  description String?
  isActive    Boolean @default(true)
  // V8: Optional post caption — bot combines with OCR for confident code detection
  postCaption String?

  // Comment reply post linking
  fbPostUrl        String? // Full FB post URL (display only)
  fbPostId         String? // Extracted numeric post ID for webhook matching

  // V10: Product Catalog
  videoUrl         String? // YouTube URL
  catalogVisible   Boolean @default(true)
  catalogSortOrder Int     @default(0)

  // V17: Bot asks customer for these before order (JSON: [{label,choices?}])
  variantOptions String?

  // V18: Image recognition metadata — used for vision-based product matching
  category         String? // dress, saree, panjabi, shirt, t-shirt, kurti, etc.
  color            String? // red, black, white, multicolor, etc.
  tags             String? // JSON array of string tags, e.g. ["floral","summer","cotton"]
  imageKeywords    String? // space-separated keywords, e.g. "floral printed maxi"
  aiDescription    String? // optional AI-generated description for matching
  visionSearchable Boolean @default(false) // if true, this product is matched via OpenAI vision (no code needed)

  // V19: Detection mode — OCR (product code, 50% cost) or AI_VISION (OpenAI Vision, full cost)
  detectionMode    String  @default("AI_VISION") // "OCR" | "AI_VISION"

  // V20: Local CLIP visual embedding — 512-dim float array stored as JSON string
  embedding        String? // e.g. "[0.23, -0.45, 0.78, ...]" — generated in background on product save

  // V21: Catalog analytics
  productViews     Int     @default(0)

  // V22: Simple products (no code/OCR/vision needed — mango, honey, etc.)
  productType   String  @default("CODED")  // "CODED" | "SIMPLE"
  unit          String?                     // "kg", "liter", "piece", "dozen" — for SIMPLE
  orderEnabled  Boolean @default(true)      // false = info-only, no order flow

  // V23: Per-product home delivery charge — "FREE" bypasses the page's normal
  // delivery-fee settings for this item; "PAID" (default) keeps today's
  // behavior of quoting the page's inside/outside Dhaka rate.
  deliveryCharge String @default("PAID") // "FREE" | "PAID"

  // V24: per-product discount. Shown/mentioned only when originalPrice > price.
  originalPrice Float?

  // V24: per-product pricing-policy override, JSON mirroring the page-level
  // PricingPolicy shape (bot-knowledge.service.ts defaultPricingPolicy()) but
  // every field optional. null = fully inherit the page's policy (today's
  // behavior, unchanged for every existing product).
  pricingPolicyOverride String?

  // V25: Restaurant/food — size/portion pricing. Each variant has its own
  // absolute price: [{label:"5 pcs", price:120, pieces?:5}]. `price` stays the
  // default/min price (display fallback + sorting). `pieces` feeds per-piece
  // recipe scaling (momo: 1 patty per piece).
  priceVariantsJson String?
  // V25: false = stockQty ignored for catalog visibility and confirm-time
  // stock checks — BOM ingredient inventory is the real stock for food items.
  trackStock        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems    OrderItem[]
  recipeItems   RecipeItem[]
  dualWearingPages Page[] @relation("DualWearing")
  dualHoldingPages Page[] @relation("DualHolding")
  liveSessionsWorn LiveSession[] @relation("SessionWorn")
  liveSessionsHeld LiveSession[] @relation("SessionHeld")

  @@unique([pageId, code])
  @@index([pageId])
}

// V25: Restaurant BOM inventory — raw materials incl. packaging (bun, chicken
// in grams, sauces, box, spoon, wrapping paper, carry bag). Deducted
// automatically from product recipes when an order is confirmed.
model Ingredient {
  id          Int     @id @default(autoincrement())
  pageId      Int
  page        Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name        String
  unit        String  @default("pcs") // gm | pcs | ml | kg | liter
  stockQty    Float   @default(0)
  minStock    Float   @default(0) // low-stock warning threshold
  costPerUnit Float   @default(0) // optional, future costing
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeItems RecipeItem[]

  @@unique([pageId, name])
  @@index([pageId])
}

// V25: One recipe row = "this product consumes qty of this ingredient".
// per="item"  → qty × OrderItem.qty (box per burger)
// per="piece" → qty × variant pieces × OrderItem.qty (patty per momo piece)
// variantLabel null = applies to all variants; set = only that size/variant
// (BBQ sauce only in the BBQ variant).
model RecipeItem {
  id           Int        @id @default(autoincrement())
  productId    Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qty          Float
  per          String     @default("item") // "item" | "piece"
  variantLabel String?

  @@index([productId])
  @@index([ingredientId])
}

model Order {
  id           Int     @id @default(autoincrement())
  pageIdRef    Int
  page         Page    @relation(fields: [pageIdRef], references: [id])
  customerPsid String  @default("")
  customerName String?
  phone        String?
  address      String?
  status       String  @default("RECEIVED")
  source       String  @default("FACEBOOK")

  negotiationRequested Boolean @default(false)
  customerOfferedPrice Float?
  orderNote            String?

  // V24: Restaurant mode — exact customer map pin + distance-slab fee
  deliveryLat        Float?
  deliveryLng        Float?
  deliveryFee        Float?
  deliveryDistanceKm Float?

  callStatus     String    @default("NONE")
  callRetryCount Int       @default(0)
  lastCallAt     DateTime?
  callResult     String?
  callSessionId  String?

  // V17: Payment tracking (advance / full-advance modes)
  // not_required | pending_proof | advance_paid | agent_required
  paymentStatus        String    @default("not_required")
  transactionId        String?
  paymentScreenshotUrl String?
  // pending_review | verified | verify_failed  (only used when paymentStatus=advance_paid)
  paymentVerifyStatus  String    @default("pending_review")
  printedAt            DateTime?

  confirmedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  editToken   String?   @unique
  cancelNote  String?

  // V25: True once stockQty has actually been decremented for this order's
  // items — lets cancelOrder restore stock safely without over-crediting
  // orders that were cancelled before stock was ever reserved.
  stockDecremented Boolean @default(false)
  // V25: same flag for BOM ingredient deduction (restaurant recipes +
  // per-order packaging) — cancel restores exactly what was deducted.
  ingredientsDeducted Boolean @default(false)

  // Spam/Fraud check result
  spamRisk        String   @default("unknown")
  spamScore       Float?
  spamTotalOrders Int?
  spamDelivered   Int?
  spamCancelled   Int?
  spamSource      String?
  spamCheckedAt   DateTime?

  items        OrderItem[]
  callAttempts CallAttempt[]

  // V5 Accounting relations
  collections     Collection[]
  expenses        Expense[]
  returnEntries   ReturnEntry[]
  exchangeEntries ExchangeEntry[]

  // V9
  courierShipment CourierShipment?
  followUps       FollowUp[]

  @@index([pageIdRef])
  @@index([customerPsid])
  @@index([status])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  productCode String
  qty         Int     @default(1)
  unitPrice   Float   @default(0)
  productName String?
  metaJson    String?

  @@index([orderId])
  @@index([productId])
}

model ConversationSession {
  id           Int    @id @default(autoincrement())
  pageIdRef    Int
  page         Page   @relation(fields: [pageIdRef], references: [id], onDelete: Cascade)
  customerPsid String

  activeDraftJson           String?
  lastPresentedProductsJson String?
  awaitingField             String?
  lastIntent                String?
  referencedMessageId       String?
  agentHandling             Boolean   @default(false) // true = bot stays silent, agent is handling
  agentHandlingAt           DateTime? // when agentHandling was set to true (for auto-expire)

  // Loop / stuck detection
  lastCustomerMsg String? // last message text customer sent
  lastDraftStep   String? // draft step after last message was processed
  loopCount       Int     @default(0) // consecutive messages without progress

  // Conversation memory — last 8 exchanges [{role,content,ts}]
  chatHistoryJson String?

  abandonedCartNotifiedAt DateTime? // debounce: when the abandoned-cart reminder was sent

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([pageIdRef, customerPsid])
  @@index([pageIdRef])
}

model CallAttempt {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pageId          Int
  page            Page    @relation(fields: [pageId], references: [id])
  phone           String
  callProvider    String  @default("manual")
  status          String  @default("INITIATED")
  dtmfInput       String?
  durationSeconds Int     @default(0)
  errorMsg        String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([pageId])
}

model MemoTemplate {
  id         Int      @id @default(autoincrement())
  pageIdRef  Int      @unique
  page       Page     @relation(fields: [pageIdRef], references: [id], onDelete: Cascade)
  filename   String
  mapping    String   @default("{}")
  status     String   @default("draft")
  renderMode String   @default("fallback-auto")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── V5 ACCOUNTING MODELS ──────────────────────────────────────────────────────

/// Manual collection entry — tracks money actually received
model Collection {
  id      Int    @id @default(autoincrement())
  pageId  Int
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // advance | full_payment | partial | cod | other_income
  type        String   @default("full_payment")
  // cash | bkash | nagad | bank | cod | other
  method      String   @default("cash")
  amount      Float    @default(0)
  note        String?
  collectedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([orderId])
  @@index([collectedAt])
}

/// Business expense entry — order-linked or general
model Expense {
  id      Int    @id @default(autoincrement())
  pageId  Int
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // courier | packaging | ads | resize | labour | sourcing | misc | other
  category String   @default("misc")
  amount   Float    @default(0)
  note     String?
  spentAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([orderId])
  @@index([spentAt])
}

/// Return adjustment — affects revenue and refund tracking
model ReturnEntry {
  id      Int   @id @default(autoincrement())
  pageId  Int
  page    Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // full | partial
  returnType   String  @default("full")
  refundAmount Float   @default(0)
  returnCost   Float   @default(0)
  note         String?

  // Advance refund tracking
  refundStatus      String    @default("pending") // pending | given | not_applicable
  refundGivenAt     DateTime?
  refundGivenAmount Float?

  // Refund method & auto-send tracking
  refundMethod       String?   // bkash_manual | nagad_manual | bkash_auto | nagad_auto | cash | bank
  refundPhoneNumber  String?   // customer phone for bKash/Nagad send
  refundGatewayTxId  String?   // txn ID from bKash/Nagad after auto-refund
  refundInitiatedAt  DateTime? // when auto-refund was triggered
  refundFailReason   String?   // error message if auto-refund failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([orderId])
}

/// Exchange adjustment — extra charge or refund on swap
model ExchangeEntry {
  id      Int   @id @default(autoincrement())
  pageId  Int
  page    Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  extraCharge      Float   @default(0)
  refundAdjustment Float   @default(0)
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([orderId])
}

// ── V9: CUSTOMER CRM ──────────────────────────────────────────────────────────

/// One record per unique customer (psid) per page
model Customer {
  id           Int        @id @default(autoincrement())
  pageId       Int
  page         Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  psid         String
  name         String?
  phone        String?
  address      String?
  note         String? // agent internal note
  tags         String     @default("[]") // JSON array of string tags
  totalOrders  Int        @default(0)
  totalSpent   Float      @default(0)
  firstOrderAt DateTime?
  lastOrderAt  DateTime?
  isBlocked    Boolean    @default(false)
  // FACEBOOK | INSTAGRAM | WHATSAPP
  platform     String     @default("FACEBOOK")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  followUps    FollowUp[]

  @@unique([pageId, psid])
  @@index([pageId])
}

// ── V9: FOLLOW-UP ──────────────────────────────────────────────────────────────

model FollowUp {
  id          Int       @id @default(autoincrement())
  pageId      Int
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  psid        String
  orderId     Int?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // pending | sent | failed | cancelled | processing
  status      String    @default("pending")
  // order_received | order_delivered | abandoned_cart | custom
  triggerType String    @default("custom")
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
  error       String?
  // FACEBOOK | INSTAGRAM | WHATSAPP
  platform    String    @default("FACEBOOK")
  createdAt   DateTime  @default(now())

  @@index([pageId])
  @@index([status, scheduledAt])
}

// ── V9: COURIER ──────────────────────────────────────────────────────────────

model CourierShipment {
  id          Int       @id @default(autoincrement())
  pageId      Int
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  orderId     Int       @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // pathao | steadfast | redx | paperfly | manual
  courierName String
  // consignment_id / tracking_code from courier
  trackingId  String?
  trackingUrl String?
  // pending | booked | picked | in_transit | delivered | returned | cancelled
  status      String    @default("pending")
  codAmount   Float     @default(0)
  weight      Float     @default(0.5)
  courierFee  Float?
  bookedAt    DateTime?
  deliveredAt DateTime?
  returnedAt  DateTime?
  rawResponse String? // full courier API response JSON
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageId])
  @@index([status])
}

// ── V9: BROADCAST ─────────────────────────────────────────────────────────────

model Broadcast {
  id          Int       @id @default(autoincrement())
  pageId      Int
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String
  message     String
  // all | tag | ordered_before | never_ordered
  targetType  String    @default("all")
  targetValue String? // e.g. tag name, date range JSON
  // draft | running | completed | failed
  status      String    @default("draft")
  totalTarget Int       @default(0)
  totalSent   Int       @default(0)
  totalFailed Int       @default(0)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  // FACEBOOK | INSTAGRAM | WHATSAPP | ALL
  platform    String    @default("FACEBOOK")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageId])
}

// ── V15: BILLING ──────────────────────────────────────────────────────────────

model Plan {
  id            String         @id @default(uuid())
  name          String         @unique // starter | pro | enterprise
  displayName   String
  priceMonthly  Float          @default(0)
  ordersLimit   Int            @default(500) // -1 = unlimited
  pagesLimit    Int            @default(1) // -1 = unlimited
  agentsLimit   Int            @default(1) // -1 = unlimited
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Status: trial | active | expired | cancelled | grace
  status String @default("trial")

  // Current billing period
  periodStart DateTime @default(now())
  periodEnd   DateTime

  // Usage tracking (reset monthly)
  ordersUsed  Int @default(0)
  ordersLimit Int @default(500) // copied from plan at creation

  // Trial
  trialEndsAt DateTime?
  isTrialUsed Boolean   @default(false)

  // Payment
  lastPaymentAt  DateTime?
  nextPaymentDue DateTime?

  note      String? // admin note
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount        Float
  currency      String  @default("BDT")
  // bkash | nagad | bank | manual
  method        String  @default("manual")
  // Transaction ID from bKash or manual reference
  transactionId String?
  // pending | confirmed | failed | refunded
  status        String  @default("pending")

  note        String?
  confirmedAt DateTime?
  confirmedBy String? // admin userId
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([subscriptionId])
}

// ── V18: WALLET PRICING SYSTEM ────────────────────────────────────────────────

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  pageId      Int
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        String // RECHARGE, DEDUCT_TEXT, DEDUCT_VOICE, DEDUCT_IMAGE, DEDUCT_ADMIN_VISION, DEDUCT_BASE_FEE
  amountBdt   Float // Positive for recharge, Negative for deduction
  description String? // e.g. "Voice message processed", "New product Vision analyzed"
  provider    String? // gemini | openai | local | null
  createdAt   DateTime @default(now())

  @@index([pageId])
}

// V26: Real AI token usage per call — priced with official provider rates
// (ai.google.dev/gemini-api/docs/pricing) so the platform profit report
// reflects measured cost instead of per-call guesses.
model AiUsage {
  id           Int      @id @default(autoincrement())
  pageId       Int?
  provider     String // gemini | openai
  model        String
  usageType    String // SMART_BOT | AI_INTENT | ...
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([pageId])
}

model WalletRechargeRequest {
  id            Int      @id @default(autoincrement())
  pageId        Int
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  amountBdt     Float
  method        String   // bkash | nagad | bank | manual
  transactionId String
  note          String?
  // pending | approved | rejected
  status        String   @default("pending")
  rejectedReason String?
  approvedAt    DateTime?
  approvedBy    String?  // admin username
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pageId])
  @@index([status])
}

model SpamCheckLog {
  id          Int      @id @default(autoincrement())
  pageId      Int
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  phone       String
  risk        String   // safe|low|medium|high|new|unknown
  score       Float    @default(0)
  totalOrders Int      @default(0)
  delivered   Int      @default(0)
  cancelled   Int      @default(0)
  successRate Float    @default(0)
  source      String   @default("internal")
  checkedAt   DateTime @default(now())

  @@index([pageId, phone])
  @@index([pageId])
}

// ── LIVE SESSION (new Dual Photo system) ─────────────────────────────────────

// ── PAGE ACCESS REQUEST ───────────────────────────────────────────────────────
// Client submits their page URL and adds the admin as a Page moderator on
// Facebook directly; admin then logs in with Facebook (via a Telegram or
// dashboard button) to confirm moderator access and auto-connect the page.

model PageRequest {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageUrl         String   // Facebook page link/username submitted by client
  fbProfile       String?  // Client's own Facebook profile link (optional, informational)
  note            String?  // Optional note from client
  status          String   @default("pending") // pending | approved | rejected
  adminNote       String?  // Admin's response note
  connectedPageId Int?     // Page row created/updated when this request was approved
  connectedPage   Page?    @relation(fields: [connectedPageId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ── BOT AGENT CATALOG ────────────────────────────────────────────────────────
// Metadata shown in onboarding's agent picker. agentKey should match a
// registered BotAgent (see backend/src/agents/); if no dedicated class exists
// yet for a key, BotAgentRegistry falls back to the "commerce" agent so the
// page still works while a developer writes the dedicated agent class.

model BotAgentDefinition {
  id          Int      @id @default(autoincrement())
  agentKey    String   @unique
  name        String
  description String   @default("")
  suitableFor String   @default("") // comma-separated tags, e.g. "fashion,electronics"
  active      Boolean  @default(true)
  // AgentBehaviorConfig JSON (see backend/src/agents/agent-behavior-config.interface.ts):
  // personaPrompt / toneRules / coreFields / systemReplies overrides for this agent type.
  // null = pure fallback to the hardcoded commerce defaults (zero behavior change).
  behaviorConfig Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// ── CUSTOM AGENT REQUESTS ────────────────────────────────────────────────────
// Submitted when a client's business type doesn't match any agent in the
// catalog. Admin gets a Telegram ping and follows up over WhatsApp.

model AgentRequest {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageUrl     String
  description String
  contactInfo String   @default("")
  status      String   @default("pending") // pending | contacted | fulfilled
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ── AUTO POST ─────────────────────────────────────────────────────────────────

model AutoPost {
  id          Int       @id @default(autoincrement())
  pageId      Int
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  caption     String
  imageUrl    String?
  imagePrompt String?
  postType    String    @default("product") // product | sale | announcement | custom
  language    String    @default("bn")      // bn | en

  // draft | scheduled | published | failed
  status      String    @default("draft")
  fbPostId    String?
  scheduledAt DateTime?
  publishedAt DateTime?
  errorMsg    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([status, scheduledAt])
}

// ── PAYMENT VERIFICATION ─────────────────────────────────────────────────────

/// Per-page payment credentials (bKash/Nagad direct or gateway like SSLCommerz/ShurjoPay)
model PaymentCredential {
  id        String   @id @default(cuid())
  pageId    Int
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  method    String   // "bkash" | "nagad" | "sslcommerz" | "shurjopay" | "zinipay"
  type      String   // "direct" | "gateway"
  isActive  Boolean  @default(false)
  credJson  String   // AES-256 encrypted JSON blob of credentials
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, method])
  @@index([pageId])
}

/// Tracks pending gateway payment links until IPN confirms payment
model PendingPayment {
  id           String   @id @default(cuid())
  pageId       Int
  psid         String   // Facebook/IG sender ID; "WEB" for web-initiated payments
  draftJson    String   // serialized DraftSession snapshot
  webOrderId   Int?     // set for web orders — used in IPN to confirm the order directly
  amount       Float
  method       String   // gateway method used
  gatewayTxId  String?  // gateway's own transaction reference
  sessionToken String   @unique // random UUID in payment link for IPN matching
  status       String   @default("pending") // pending | paid | expired | failed
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([pageId])
  @@index([sessionToken])
  @@index([status])
}

// ── RECURRING NOTIFICATION SUBSCRIBERS ───────────────────────────────────────
/// Customers who opted-in for recurring product/offer notifications after order complete
model RecurringSubscriber {
  id             String    @id @default(uuid())
  pageId         Int
  page           Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  psid           String    // Facebook Messenger PSID
  name           String?
  token          String    // Facebook optin token for recurring notifications
  frequency      String    @default("WEEKLY") // DAILY | WEEKLY | MONTHLY
  tokenExpiresAt DateTime
  lastNotifiedAt DateTime?
  promptedAt     DateTime  @default(now())
  declined       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([pageId, psid])
  @@index([pageId])
  @@index([pageId, declined])
}

// SMS received on merchant's phone via Android SMS forwarder app — used for payment verification
// SMS received on merchant's phone via Android SMS forwarder app — used for payment verification
// pageId=null means it's from the chatcat admin's own phone (for billing subscription payments)
model ReceivedSms {
  id          String   @id @default(cuid())
  pageId      Int?
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  isAdminSms  Boolean  @default(false) // true = chatcat admin billing SMS
  rawText     String
  method      String   // "bkash" | "nagad" | "rocket"
  txId        String?
  amount      Float?
  senderPhone String?
  receivedAt  DateTime @default(now())
  matched     Boolean  @default(false)

  @@index([pageId, txId])
  @@index([pageId, senderPhone])
  @@index([isAdminSms, txId])
  @@index([isAdminSms, matched, receivedAt])
}

model LiveSession {
  id            Int       @id @default(autoincrement())
  pageId        Int
  page          Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label         String?                       // optional name e.g. "Live 29 April"
  screenshots   String    @default("[]")      // JSON array of screenshot image URLs
  wornProductId Int?
  heldProductId Int?
  wornProduct   Product?  @relation("SessionWorn", fields: [wornProductId], references: [id])
  heldProduct   Product?  @relation("SessionHeld", fields: [heldProductId], references: [id])
  aiMemo        String?                       // JSON: AI visual description of each product
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([pageId])
  @@index([pageId, isActive])
}

model SmsDevice {
  id          Int      @id @default(autoincrement())
  pageId      Int?     // null = admin device
  deviceName  String
  deviceModel String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([pageId])
}

// ── UNIVERSITY AUTOMATION ─────────────────────────────────────────────────────

model UniversityConfig {
  id              Int      @id @default(autoincrement())
  pageId          Int      @unique
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  scrapeUrl       String   @default("")       // notice page URL for auto-posting
  crawlBaseUrl    String   @default("")       // homepage URL for full site knowledge crawl
  scrapeInterval  Int      @default(30)
  scrapeEnabled   Boolean  @default(true)
  autoPostEnabled Boolean  @default(true)
  lastScrapedAt   DateTime?
  lastFullCrawlAt DateTime?
  knowledgeText   String   @default("")       // manually typed extra info
  scrapedKnowledgeText String @default("")   // auto-populated by full site crawl
  extractedMeta   String   @default("{}")    // AI-extracted: {departments,semesters,courses} for group link form
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notices    UniversityNotice[]
  groupLinks GroupLink[]
  faqs       UniversityFaq[]
}

model UniversityFaq {
  id        Int              @id @default(autoincrement())
  configId  Int
  config    UniversityConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  pageId    Int
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([configId])
}

model UniversityNotice {
  id          Int              @id @default(autoincrement())
  configId    Int
  config      UniversityConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  pageId      Int
  title       String
  url         String?
  publishedAt String?
  contentHash String
  fbPostId    String?
  autoPosted  Boolean  @default(false)
  postError   String?
  createdAt   DateTime @default(now())

  @@unique([configId, contentHash])
  @@index([pageId])
}

model GroupLink {
  id         Int              @id @default(autoincrement())
  configId   Int
  config     UniversityConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  pageId     Int
  label      String
  semester   String?
  department String?
  course     String?
  linkType   String           // "whatsapp" | "messenger"
  link       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([configId])
  @@index([pageId])
}
